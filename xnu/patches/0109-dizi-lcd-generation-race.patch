diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -119,6 +119,7 @@
 	uint32_t      fFlushTicks;    /* vsync ticks between panel copies */
 	bool          fPowerOff;      /* RequestPowerChange(0) */
 	uint32_t      fFadeStep;      /* fade-out steps done while off */
+	uint64_t      fFadeEpoch;     /* guarded by fLock; distinct from hardware generation */
 	struct sweet_lcd_state fDiziLCD; /* no native MMIO backend */
 
 	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
@@ -202,6 +203,7 @@
 	sweet_lcd_init(&fDiziLCD, dizi == 1, lcd == 1, fWidth, fHeight);
 	fPowerOff = false;
 	fFadeStep = 0;
+	fFadeEpoch = 0;
 	fLock = IOLockAlloc();
 	fClients = OSArray::withCapacity(4);
 	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
@@ -260,23 +262,39 @@
 		/* Dizi LCD: black pixels do NOT switch off the physical lamp. */
 		uint32_t step = fb->fFadeStep;
 		uint32_t generation = fb->fDiziLCD.generation;
+		uint64_t fadeEpoch = fb->fFadeEpoch;
 		if (step <= 6) {
 			fb->fFadeStep = step + 1;
 		}
 		IOLockUnlock(fb->fLock);
+		bool completed = true;
 		if (step <= 6) {
+			/* At most ONE scanline is written with fLock held (6.4 KiB
+			 * on dizi). Power-on acquires this same lock, so no obsolete
+			 * OFF pixel store can occur after an ON transition.  The
+			 * epoch also rejects OFF -> ON -> OFF (ABA) while this tick
+			 * is running. Do not hold the lock for the full framebuffer. */
 			for (uint32_t y = 0; y < fb->fHeight; y++) {
+				IOLockLock(fb->fLock);
+				if (!fb->fPowerOff || fb->fFadeEpoch != fadeEpoch) {
+					completed = false;
+					IOLockUnlock(fb->fLock);
+					break;
+				}
 				volatile uint32_t *row = (volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
 				for (uint32_t x = 0; x < fb->fWidth; x++) {
 					row[x] = step < 6 ? (row[x] >> 1) & 0x7f7f7f7f : 0;
 				}
+				IOLockUnlock(fb->fLock);
 			}
 		}
-		if (step == 6) {
+		if (step == 6 && completed) {
 			IOLockLock(fb->fLock);
-			/* Generation prevents a late off following an intervening wake.
-			 * NULL proof/backend: no GPIO, DSI or regulator writes. */
-			(void)sweet_lcd_black_frame_done(&fb->fDiziLCD, generation, NULL, NULL);
+			/* Both the framebuffer and 0103 hardware-generation epochs
+			 * must still match before declaring the black frame done. */
+			if (fb->fPowerOff && fb->fFadeEpoch == fadeEpoch) {
+				(void)sweet_lcd_black_frame_done(&fb->fDiziLCD, generation, NULL, NULL);
+			}
 			IOLockUnlock(fb->fLock);
 		}
 		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
@@ -581,6 +599,7 @@
 				ret = kIOReturnNotReady;
 			} else if (off != fFB->fPowerOff) {
 				fFB->fPowerOff = off;
+				fFB->fFadeEpoch++; /* invalidate any unlocked VSYNC OFF tick */
 				fFB->fFadeStep = 0;
 				fFB->fDirty = true;     /* on: redraw the latest frame */
 			}
