+	printf("SWEET USB: %s GDSC usb30_prim 0x%08x (%s)\n", kind, gdscr,
+	    (gdscr & (1u << 31)) ? "on" : "off");
+	for (unsigned i = 0; i < nclocks; i++) {
+		const char *name = dizi ? usb_cbcr_dizi[i].name : usb_cbcr[i].name;
