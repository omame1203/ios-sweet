+/* SM7435 (dizi) GCC: the controller register block is the same, but the
+ * USB30 GDSC and branch clocks live at the 0x149xxx offsets. There is no
+ * ahb2phy branch and the HS PHY is left exactly as ABL programmed it. */
+#define GCC_USB30_PRIM_GDSCR_DIZI 0x49004
+static const struct {
+	const char *name;
+	uint32_t    off;
+} usb_cbcr_dizi[] = {
+	{ "master", 0x49018 },
+	{ "sleep", 0x49020 },
+	{ "utmi", 0x49024 },
+	{ "iface", 0x49084 },
+	{ "aggre", 0x49088 },
+};
+
 #define DWC3_PA                 0x0a600000
 #define DWC3_SIZE               0x0000d000
 #define QUSB2_PA                0x088e2000
@@ -76,12 +91,15 @@
 void
 sweet_usb_probe(void)
 {
