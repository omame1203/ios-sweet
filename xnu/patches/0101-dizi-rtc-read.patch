+/* PMK8350 SID0, peripheral 0x61 (SPMI PPID 0x061); live dizi FDT
+ * rtc@6100; vendor rtc-pm8xxx.c pmk8350_regs: CTRL 0x6146,
+ * little-endian READ_TIME 0x6148..0x614b. This RTC is never written.
+ * Uses one v7 observer APID distinct from the PON and GPIO APIDs. */
+#define DIZI_RTC_PPID          0x061u
+#define DIZI_RTC_CTRL          0x6146u
+#define DIZI_RTC_READ          0x6148u
+#define DIZI_RTC_ENABLE        0x80u
+#define DIZI_RTC_MIN_SECONDS   1577836800u  /* 2020-01-01 UTC */
+#define DIZI_RTC_MAX_SECONDS   4102444800u  /* 2100-01-01 UTC, exclusive */
+#define DIZI_RTC_ATTEMPTS      5u
+static uint16_t dizi_rtc_apid = KEYS_NO_APID;
+static bool dizi_rtc_ready;
+static LCK_GRP_DECLARE(dizi_rtc_lock_group, "dizi rtc observer");
+static LCK_MTX_DECLARE(dizi_rtc_lock, &dizi_rtc_lock_group);
 
