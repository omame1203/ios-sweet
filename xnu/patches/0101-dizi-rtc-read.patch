+/* DIZI_RTC_TEST_BEGIN: host tests extract these exact parser routines. */
+static uint32_t
+dizi_rtc_decode(const uint8_t b[4])
+{
+    return (uint32_t)b[0] | ((uint32_t)b[1] << 8) |
+        ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+}
+
+static bool
+dizi_rtc_valid_pair(uint32_t first, uint32_t second)
+{
+    /* Reject unset/out-of-policy clocks and all large/backward jumps.
+     * This is NOT proof that an RTC ticks or is synchronized to real UTC. */
+    return first >= DIZI_RTC_MIN_SECONDS && second < DIZI_RTC_MAX_SECONDS &&
+        second >= first && second - first <= 1u;
+}
+/* DIZI_RTC_TEST_END */
+
+/* Observe only. Re-reading LSB after the four individual EXT_READL requests
+ * rejects a carry while building the word. Then acquire a second complete
+ * snapshot; accept only identical or +1 second in the bounded sequence.
+ * A failure does not update the XNU calendar or create synthetic dates. */
+static bool
+dizi_rtc_read_image(uint32_t *out)
+{
+    uint8_t bytes[4], low;
+    for (unsigned i = 0; i < 4; i++) {
+        if (!keys_read(dizi_rtc_apid, DIZI_RTC_READ + (uint16_t)i, &bytes[i]))
+            return false;
+    }
+    if (!keys_read(dizi_rtc_apid, DIZI_RTC_READ, &low) || low != bytes[0])
+        return false;
+    *out = dizi_rtc_decode(bytes);
+    return true;
+}
+
+static bool
+dizi_rtc_sample(uint32_t *out)
+{
+    uint8_t control;
+    if (!keys_read(dizi_rtc_apid, DIZI_RTC_CTRL, &control) ||
+        !(control & DIZI_RTC_ENABLE))
+        return false;
+    for (unsigned attempt = 0; attempt < DIZI_RTC_ATTEMPTS; ++attempt) {
+        uint32_t first = 0, second = 0;
+        if (!dizi_rtc_read_image(&first) || !dizi_rtc_read_image(&second))
+            continue;
+        if (!dizi_rtc_valid_pair(first, second))
+            continue;
+        *out = second;
+        return true;
+    }
+    return false;
+}
+
+/* Explicitly opt in: dizihw=1 dizirtc=1. Exposes fresh seconds to userland:
+ * sysctlbyname("kern.dizirtc_seconds", &uint64, &len, NULL, 0).
+ * A plausible counter value alone is NOT proof of calibrated UTC or ticking.
+ * No call to clock_set_calendar_microtime/PEGetUTCTimeOfDay/settimeofday:
+ * current physical RTC state has not been measured, so we cannot choose
+ * an authoritative wall clock source automatically. */
+static int
+sysctl_dizi_rtc_seconds SYSCTL_HANDLER_ARGS
+{
+    uint32_t seconds = 0;
+    uint64_t observed = 0;
+    if (req->newptr != USER_ADDR_NULL)
+        return EPERM;
+    if (!dizi_rtc_ready)
+        return ENXIO;
+    lck_mtx_lock(&dizi_rtc_lock);
+    bool ok = dizi_rtc_sample(&seconds);
+    lck_mtx_unlock(&dizi_rtc_lock);
+    if (!ok)
+        return EIO;
+    observed = seconds;
+    return sysctl_handle_quad(oidp, &observed, 0, req);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, dizirtc_seconds,
+    CTLTYPE_QUAD | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_dizi_rtc_seconds, "Q",
+    "Dizi PMK8350 RTC counter, epoch seconds (unsynchronized; read-only)");
 
