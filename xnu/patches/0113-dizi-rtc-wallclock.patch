+ * In bsd_init, IOKitInitializeTime/clock_initialize_calendar precedes the
+ * UFS sweet_keys_init call. The settime_lock interlocks with settimeofday.
+ * Never call PESetUTCTimeOfDay (platform RTC write) on this path.
+ */
+bool
+clock_seed_calendar_from_dizi_rtc(clock_sec_t secs, clock_usec_t microsecs)
+{
+    uint64_t absolutesys, commpage_value = 0;
+    clock_sec_t oldsecs, deltasecs;
+    clock_usec_t oldmicrosecs, deltamicrosecs;
+    struct bintime bt;
+    spl_t s;
+    bool accepted = false;
