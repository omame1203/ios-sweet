diff --git a/bsd/dev/sweet_lcd.h b/bsd/dev/sweet_lcd.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_lcd.h
@@ -0,0 +1,77 @@
+/*
+ * Dizi BOE LCD VIDEO mode: power-policy model, deliberately no MMIO backend.
+ * Host-testable C interface used by the IOMobileFramebuffer power selector.
+ * The current native port inherits an already-lit ABL splash: video scanout,
+ * GPIO57 polarity/direction, and panel-supply ownership are NOT verified.
+ */
+#ifndef _BSD_DEV_SWEET_LCD_H_
+#define _BSD_DEV_SWEET_LCD_H_
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SWEET_LCD_DIZI_WIDTH       1600u
+#define SWEET_LCD_DIZI_HEIGHT      2560u
+#define SWEET_LCD_DIZI_BL_GPIO     57u   /* TLMM: FDT platform-bklight-en */
+#define SWEET_LCD_DIZI_RESET_GPIO  98u   /* TLMM: do not drive without DSI/rail bringup */
+#define SWEET_LCD_MAX_BRIGHTNESS   4095u /* FDT: 12-bit external brightness */
+
+enum sweet_lcd_phase {
+    SWEET_LCD_UNMANAGED = 0,
+    SWEET_LCD_INHERITED_LIT,
+    SWEET_LCD_FADING,
+    SWEET_LCD_SOFTWARE_BLACK,
+    SWEET_LCD_BACKLIGHT_GATED,
+    SWEET_LCD_FAULT
+};
+enum sweet_lcd_result {
+    SWEET_LCD_ERROR = -1,
+    SWEET_LCD_OK = 0,
+    SWEET_LCD_DEFERRED = 1
+};
+
+/* Each fact must have independent trusted controller-side evidence. Neither
+ * the Android FDT GPIO spec nor a boot-arg alone asserts these as true. */
+struct sweet_lcd_proof {
+    bool boe_panel_confirmed;
+    bool dsi_video_scanning;
+    bool tlmm57_exclusive_owner;
+    bool tlmm57_is_gpio_output;
+    bool tlmm57_active_high_confirmed;
+};
+
+/* Optional, future, verified backlight-only backend. NO implementation is
+ * installed by patch 0103. Never use this interface for DSI, reset GPIO98,
+ * PMIC GPIO rails, Pinctrl, regulator operations, or brightness PWM writes.
+ * get() must read back current hardware state (not shadow a requested value).
+ */
+struct sweet_lcd_backlight_ops {
+    void *context;
+    bool (*get_enabled)(void *context, bool *enabled);
+    bool (*set_enabled)(void *context, bool enabled);
+};
+
+struct sweet_lcd_state {
+    enum sweet_lcd_phase phase;
+    uint32_t generation;
+    uint16_t requested_brightness;
+    bool selected;               /* requires dizihw && dizilcd && 1600x2560 */
+    bool off_requested;
+};
+
+void sweet_lcd_init(struct sweet_lcd_state *state, bool dizi, bool opt_in,
+    uint32_t width, uint32_t height);
+int sweet_lcd_request(struct sweet_lcd_state *state, bool off,
+    const struct sweet_lcd_proof *proof,
+    const struct sweet_lcd_backlight_ops *ops);
+int sweet_lcd_black_frame_done(struct sweet_lcd_state *state,
+    uint32_t generation, const struct sweet_lcd_proof *proof,
+    const struct sweet_lcd_backlight_ops *ops);
+int sweet_lcd_set_brightness(struct sweet_lcd_state *state, unsigned level);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/sweet_lcd.c b/bsd/dev/sweet_lcd.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_lcd.c
@@ -0,0 +1,110 @@
+/*
+ * POCO Pad (dizi) BOE LCD power foundation.
+ * Evidence: backup/dizi/live.dts panel qcom,mdss_dsi_n83_35_02_0a_...
+ *  - DSI VIDEO, externally controlled 12-bit backlight (1..0xfff)
+ *  - TLMM GPIO57 backlight-enable; TLMM GPIO98 panel reset
+ *  - FDT reset = {high10ms, low10ms, high10ms} (NOT a suspend sequence)
+ *  - BOE panel-supply-entries = dummy, not the generic LCD power rails.
+ * No DSI engine, brightness generator, reset, rail, or TLMM writer is here.
+ */
+#include "sweet_lcd.h"
+
+static bool
+bl_ready(const struct sweet_lcd_proof *p,
+    const struct sweet_lcd_backlight_ops *ops)
+{
+    return p != 0 && p->boe_panel_confirmed && p->dsi_video_scanning &&
+        p->tlmm57_exclusive_owner && p->tlmm57_is_gpio_output &&
+        p->tlmm57_active_high_confirmed && ops != 0 &&
+        ops->get_enabled != 0 && ops->set_enabled != 0;
+}
+
+/* A failure after a write might have changed the pin: restore its prior
+ * verified state. If undo or its readback fails, permanently fail closed. */
+static bool
+write_verified(struct sweet_lcd_state *s,
+    const struct sweet_lcd_backlight_ops *ops, bool expected, bool target)
+{
+    bool observed = false;
+    if (!ops->get_enabled(ops->context, &observed) || observed != expected)
+        return false;
+    if (ops->set_enabled(ops->context, target) &&
+        ops->get_enabled(ops->context, &observed) && observed == target)
+        return true;
+    if (!ops->set_enabled(ops->context, expected) ||
+        !ops->get_enabled(ops->context, &observed) || observed != expected)
+        s->phase = SWEET_LCD_FAULT;
+    return false;
+}
+
+void
+sweet_lcd_init(struct sweet_lcd_state *s, bool dizi, bool opt_in,
+    uint32_t w, uint32_t h)
+{
+    s->selected = dizi && opt_in && w == SWEET_LCD_DIZI_WIDTH &&
+        h == SWEET_LCD_DIZI_HEIGHT;
+    s->phase = s->selected ? SWEET_LCD_INHERITED_LIT : SWEET_LCD_UNMANAGED;
+    s->generation = 0;
+    s->requested_brightness = SWEET_LCD_MAX_BRIGHTNESS;
+    s->off_requested = false;
+}
+
+int
+sweet_lcd_request(struct sweet_lcd_state *s, bool off,
+    const struct sweet_lcd_proof *p, const struct sweet_lcd_backlight_ops *ops)
+{
+    if (!s->selected || s->phase == SWEET_LCD_UNMANAGED)
+        return SWEET_LCD_DEFERRED;
+    if (s->phase == SWEET_LCD_FAULT)
+        return SWEET_LCD_ERROR;
+    if (off) {
+        if (s->off_requested)
+            return SWEET_LCD_OK;
+        s->off_requested = true;
+        s->generation++;
+        s->phase = SWEET_LCD_FADING;
+        return SWEET_LCD_OK;
+    }
+    /* A saved OFF state is never treated as proof the lamp is disabled. */
+    if (s->phase == SWEET_LCD_BACKLIGHT_GATED) {
+        if (!bl_ready(p, ops) ||
+            !write_verified(s, ops, false, true))
+            return SWEET_LCD_ERROR; /* don't unblank a lamp left off */
+    }
+    if (!s->off_requested)
+        return SWEET_LCD_OK;
+    s->off_requested = false;
+    s->generation++;
+    s->phase = SWEET_LCD_INHERITED_LIT;
+    return SWEET_LCD_OK;
+}
+
+int
+sweet_lcd_black_frame_done(struct sweet_lcd_state *s, uint32_t generation,
+    const struct sweet_lcd_proof *p, const struct sweet_lcd_backlight_ops *ops)
+{
+    if (!s->selected || !s->off_requested ||
+        generation != s->generation || s->phase != SWEET_LCD_FADING)
+        return SWEET_LCD_DEFERRED;
+    s->phase = SWEET_LCD_SOFTWARE_BLACK;
+    /* A black LCD frame is NOT backlight-off.  Keep ABL panel powered
+     * unless a future adapter positively verifies the independent lamp. */
+    if (!bl_ready(p, ops))
+        return SWEET_LCD_DEFERRED;
+    if (!write_verified(s, ops, true, false))
+        return SWEET_LCD_ERROR;
+    s->phase = SWEET_LCD_BACKLIGHT_GATED;
+    return SWEET_LCD_OK;
+}
+
+int
+sweet_lcd_set_brightness(struct sweet_lcd_state *s, unsigned level)
+{
+    if (!s->selected || s->phase == SWEET_LCD_FAULT ||
+        level > SWEET_LCD_MAX_BRIGHTNESS)
+        return SWEET_LCD_ERROR;
+    /* FDT supplies an amplitude range, NOT a trusted DSI/PWM transport.
+     * Persist requested level only; neither 0 nor 4095 writes hardware. */
+    s->requested_brightness = (uint16_t)level;
+    return SWEET_LCD_DEFERRED;
+}
