+/* Oldest byte still readable in the 4 MiB RAM ring (for the USB EP0 log). */
+uint64_t
+sweet_log_oldest(void)
+{
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	return total > SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : 0;
+}
