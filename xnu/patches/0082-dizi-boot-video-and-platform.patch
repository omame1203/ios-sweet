 {
-	if (early_disabled) {
+	if (early_disabled || early_fb == NULL) {
 		return;
 	}
 	if (!early_started) {
@@ -89,7 +108,7 @@
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
