+static volatile uint32_t *early_fb;
+static unsigned int early_width, early_height, early_stride;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_WIDTH early_width
+#define EARLY_HEIGHT early_height
+#define EARLY_STRIDE early_stride
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -27,6 +28,24 @@
 /* Initialized data must remain writable until disable, including panics. */
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
+
+void
+sweet_early_init(uint64_t base, uint64_t width, uint64_t height, uint64_t stride)
+{
+	/* The bootstrap maps a single 32 MiB framebuffer block. Validate before
+	 * using dimensions supplied by a different board's loader. */
+	if (base == 0 || (base & 0x1ffffff) != 0 || width < 1024 ||
+	    height < 64 || width > 8192 || height > 8192 ||
+	    stride < width * 4 || (stride & 3) || stride > 32768 ||
+	    stride * height > 0x2000000) {
+		early_disabled = 1;
+		return;
+	}
+	early_width = (unsigned int)width;
+	early_height = (unsigned int)height;
+	early_stride = (unsigned int)(stride / 4);
+	early_fb = (volatile uint32_t *)(uintptr_t)base;
+}
 
 static void
 sweet_early_clear_row(void)
@@ -42,7 +61,7 @@
