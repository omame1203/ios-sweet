+/* A single Novatek report -> ONE coherent digitizer collection.
+ * Invoked only by BSD's 0100 post-handshake/read/checksum path. The existing
+ * IOHIDEventService and user-client queue are the sole event owner; no second
+ * IOService or synthetic touch generator is registered.
+ */
+bool
+SweetHIDTouch::novatekFrame(uint32_t mask, const int *x, const int *y,
+    uint64_t sequence, bool verified_spi_report, bool cancel)
+{
+    if (!fNovatekBridge || !fLock || !x || !y)
+        return false;
+    struct dizi_nvt_hid_frame frame = {};
+    frame.active = mask;
+    frame.sequence = sequence;
+    frame.verified_spi_report = verified_spi_report;
+    frame.cancel = cancel;
+    for (unsigned i = 0; i < DIZI_NVT_HID_CONTACTS; ++i) {
+        frame.x[i] = x[i];
+        frame.y[i] = y[i];
+    }
+
+    IOLockLock(fLock);
+    struct dizi_nvt_hid_state next = {};
+    struct dizi_nvt_hid_plan plan = {};
+    if (!dizi_nvt_hid_plan(&fNovatekState, &frame, fLogicalW, fLogicalH,
+        &next, &plan)) {
+        IOLockUnlock(fLock);
+        return false;
+    }
+    if (!plan.changed) {
+        /* A successfully observed, unmodified frame advances the local
+         * sequence but creates no spurious HID movement. */
+        fNovatekState = next;
+        IOLockUnlock(fLock);
+        return true;
+    }
+
+    uint64_t now = mach_absolute_time();
+    IOHIDEvent *collection = IOHIDEvent::digitizerEvent(now, 0,
+        kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
+    if (!collection) {
+        IOLockUnlock(fLock);
+        return false;
+    }
+    collection->setIntegerValue(kIOHIDEventFieldDigitizerCollection, TRUE);
+    UInt32 cmask = 0;
+    int first = -1;
+    /* Both surviving active fingers and newly-ended fingers are present in
+     * one frame; stable Novatek ID (1..10) maps to HID index (0..9). */
+    uint32_t included = plan.active | plan.ended;
+    for (unsigned i = 0; i < DIZI_NVT_HID_CONTACTS; ++i) {
+        UInt32 bit = 1u << i;
+        if (!(included & bit)) continue;
+        bool down = (plan.active & bit) != 0;
+        if (first < 0) first = (int)i;
+        IOHIDEvent *child = IOHIDEvent::digitizerEvent(now, i + 2,
+            kIOHIDDigitizerTransducerTypeFinger, down, down ? 1 : 0,
+            (IOFixed)plan.fx[i], (IOFixed)plan.fy[i]);
+        if (!child) {
+            collection->release();
+            IOLockUnlock(fLock);
+            return false;
+        }
+        UInt32 flags = (plan.edges & bit) ?
+            kIOHIDDigitizerEventFromEdgeTip : 0;
+        if ((plan.started | plan.ended) & bit)
+            flags |= kIOHIDDigitizerEventTouch | kIOHIDDigitizerEventRange;
+        if ((plan.started | plan.moved) & bit)
+            flags |= kIOHIDDigitizerEventPosition;
+        if (plan.started & bit)
+            flags |= kIOHIDDigitizerEventIdentity;
+        child->setIntegerValue(kIOHIDEventFieldDigitizerIndex, i);
+        child->setIntegerValue(kIOHIDEventFieldDigitizerIdentity, i + 2);
+        child->setIntegerValue(kIOHIDEventFieldDigitizerTouch, down);
+        child->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, flags);
+        collection->appendChild(child);
+        child->release();
+        cmask |= flags;
+    }
+    IOFixed cx = first < 0 ? 0 : (IOFixed)plan.fx[first];
+    IOFixed cy = first < 0 ? 0 : (IOFixed)plan.fy[first];
+    bool any = plan.active != 0;
+    collection->setFixedValue(kIOHIDEventFieldDigitizerX, cx);
+    collection->setFixedValue(kIOHIDEventFieldDigitizerY, cy);
+    collection->setIntegerValue(kIOHIDEventFieldDigitizerRange, any);
+    collection->setIntegerValue(kIOHIDEventFieldDigitizerTouch, any);
+    collection->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, cmask);
+    collection->setIntegerValue(kIOHIDEventFieldDigitizerButtonMask, any ? 1 : 0);
+    fNovatekState = next;
+    IOLockUnlock(fLock);
+    dispatchEvent(collection);
+    collection->release();
+    return true;
+}
+
+extern "C" bool
+dizi_nvt_hid_frame(uint32_t mask, const int *x, const int *y,
+    uint64_t sequence, bool verified_spi_report, bool cancel)
+{
+    return gSweetTouch && gSweetTouch->novatekFrame(mask, x, y,
+        sequence, verified_spi_report, cancel);
+}
