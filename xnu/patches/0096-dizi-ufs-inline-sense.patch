+/* Normalize fixed and descriptor sense without reading past supplied bytes. */
+static bool
+ufs_sense_decode(const uint8_t *s, unsigned len, uint8_t *key, uint8_t *asc, uint8_t *ascq)
+{
+	if (!len) {
+		return false;
+	}
+	switch (s[0] & 0x7f) {
+	case 0x70: case 0x71:
+		if (len < 14 || s[7] < 6) {
+			return false;
+		}
+		*key = s[2] & 15; *asc = s[12]; *ascq = s[13];
+		return true;
+	case 0x72: case 0x73:
+		if (len < 4) {
+			return false;
+		}
+		*key = s[1] & 15; *asc = s[2]; *ascq = s[3];
+		return true;
+	default:
+		return false;
+	}
+}
+
 /*
  * One SCSI command in slot 0, data (if any) to/from the bounce buffer
  * (to the device when write is set). Returns 0 or an errno.
@@ -153,6 +180,7 @@
