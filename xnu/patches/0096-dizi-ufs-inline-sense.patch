-		printf("SWEET UFS: command 0x%02x check condition\n", cdb[0]);
+		/* The target may set response=1 together with CHECK CONDITION.
+		 * Inspect its embedded sense before classifying the failure; do not
+		 * discard it or overwrite it with a new REQUEST SENSE command. */
+		unsigned segment = ((unsigned)ucd->resp[10] << 8) | ucd->resp[11];
+		unsigned slen = ((unsigned)ucd->resp[32] << 8) | ucd->resp[33];
+		unsigned available = segment >= 2 ? MIN(segment - 2, sizeof(ucd->resp) - 34) : 0;
+		available = MIN(available, slen);
+		su.sense_valid = ufs_sense_decode(ucd->resp + 34, available,
+		    &su.sense_key, &su.sense_asc, &su.sense_ascq);
+		printf("SWEET UFS: command 0x%02x LUN %u check condition response 0x%x sense len %u/%u\n",
+		    cdb[0], su.lun, ucd->resp[6], slen, segment);
+		if (su.sense_valid) {
+			printf("SWEET UFS: inline sense key 0x%x ASC 0x%02x ASCQ 0x%02x\n",
