--- /dev/null
+++ b/bsd/dev/dizi_usb_link.h
@@ -0,0 +1,21 @@
+/* Dizi USB ECM host-link policy, no hardware operations. */
+#ifndef DIZI_USB_LINK_H
+#define DIZI_USB_LINK_H
+#include <stdbool.h>
+#include <stdint.h>
+struct dizi_usb_link {
+    bool enabled;    /* explicit diziusbnet=1 && dizihw=1 && diziusb=1 */
+    bool attached;   /* existing BSD ue0 ifnet successfully attached */
+    bool connected;  /* a DWC3 connect-done event was received */
+    bool configured; /* host SET_CONFIGURATION(1) succeeded */
+    uint8_t alt;     /* CDC data interface SET_INTERFACE(1) */
+};
+static inline bool dizi_usb_link_ready(const struct dizi_usb_link *s) {
+    return s->enabled && s->attached && s->connected && s->configured && s->alt == 1;
+}
+static inline void dizi_usb_link_reset(struct dizi_usb_link *s) {
+    s->connected = false;
+    s->configured = false;
+    s->alt = 0;
+}
+#endif
