+static void
+dizi_link_refresh(void)
+{
+	if (!dizi_link.enabled) return;
+	bool carrier = dizi_usb_link_ready(&dizi_link);
+	if (carrier == dizi_link_last_carrier) return;
+	/* Publish carrier only if BSD accepted the transition; failure must
+	 * not make IOKit/configd claim the transport is functional. */
+	if (ud.ifp == NULL ||
+	    ifnet_set_flags(ud.ifp, carrier ? IFF_RUNNING : 0, IFF_RUNNING) != 0)
+		carrier = false;
+	__atomic_store_n(&dizi_link_carrier, carrier, __ATOMIC_RELEASE);
+	dizi_link_last_carrier = carrier;
+	dizi_usb_ecm_link(carrier);
+	ud_link_event(carrier);
