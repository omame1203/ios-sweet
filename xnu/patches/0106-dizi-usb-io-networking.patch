diff --git a/iokit/Kernel/arm/DiziUSBEthernet.cpp b/iokit/Kernel/arm/DiziUSBEthernet.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/DiziUSBEthernet.cpp
@@ -0,0 +1,78 @@
+/*
+ * Dizi USB-ECM real-ifnet IOKit companion. NO IONetworkingFamily impostor.
+ * The actual Ethernet NIC is BSD ue0, whose output/RX handlers belong to
+ * sweet_usb.c and can convey traffic only when CDC data altsetting is live.
+ *
+ * This IOService does not allocate a second ifnet, claim a Wi-Fi device,
+ * expose a fake IONetworkController subclass, or pretend that an IONetwork-
+ * Interface (not present in this XNU build) was registered. BSD provides
+ * the packet transport; this service publishes *observed* link metadata.
+ * Future full IONetworkingFamily requires its real sources and converting
+ * ue0 ownership; do not register two DLIL interfaces for one USB gadget.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+
+class DiziUSBECMController final : public IOService {
+    OSDeclareDefaultStructors(DiziUSBECMController);
+public:
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    void update(bool connected);
+};
+OSDefineMetaClassAndStructors(DiziUSBECMController, IOService);
+
+static DiziUSBECMController *dizi_ecm;
+
+bool DiziUSBECMController::start(IOService *provider) {
+    if (!IOService::start(provider)) return false;
+    setName("DiziUSBECMController");
+    /* This is a concrete BSD Ethernet adapter, not a synthetic WLAN MAC. */
+    if (!setProperty("IOBSDName", "ue0") ||
+        !setProperty("DiziUSBECMUnderlyingIfnet", "ue0") ||
+        !setProperty("DiziUSBECMTransport", "CDC-ECM") ||
+        !setProperty("DiziUSBECMCarrier", kOSBooleanFalse) ||
+        !setProperty("DiziUSBECMInternetVerified", kOSBooleanFalse)) return false;
+    registerService();
+    return true;
+}
+void DiziUSBECMController::update(bool connected) {
+    /* Configured plus altsetting is only a USB-carrier indication;
+     * NOT proof of delivered Ethernet frames, gateway or Internet. */
+    setProperty("DiziUSBECMCarrier", connected ? kOSBooleanTrue : kOSBooleanFalse);
+}
+
+extern "C" bool dizi_usb_ecm_publish(const uint8_t *mac) {
+    if (dizi_ecm || mac == nullptr) return false;
+    IOPlatformExpert *provider = IOService::getPlatform();
+    if (!provider) return false;
+    DiziUSBECMController *s = new DiziUSBECMController;
+    if (!s) return false;
+    bool attached = false;
+    if (s->init()) {
+        attached = s->attach(provider);
+        if (attached) {
+            /* BOE/WLAN identity is unrelated. This is the fixed CDC-ECM
+             * device-side MAC already used by the existing BSD ifnet. */
+            if (!s->setProperty("local-mac-address", (void *)mac, 6) ||
+                !s->setProperty("IOMACAddress", (void *)mac, 6) || !s->start(provider)) {
+                s->detach(provider);
+                attached = false;
+            }
+        }
+    }
+    if (!attached) {
+        s->release();
+        return false;
+    }
+    /* Owned for kernel lifetime: BSD gadget worker has no detach path. */
+    dizi_ecm = s;
+    return true;
+}
+extern "C" void dizi_usb_ecm_link(bool connected) {
+    if (dizi_ecm) dizi_ecm->update(connected);
+}
+#endif
