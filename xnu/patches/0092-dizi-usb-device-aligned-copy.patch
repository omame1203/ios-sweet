+/* The dizi fixed DMA buffer is mapped Device-nGnRnE via ml_io_map; only
+ * naturally aligned accesses are allowed. Copy through 32-bit words. */
+static void
+ud_dma_write(void *dst, const void *src, size_t n)
+{
+	volatile uint8_t *d = dst;
+	const uint8_t *s = src;
+	while (n >= 4 && ((uintptr_t)d & 3) == 0) {
+		uint32_t v = (uint32_t)s[0] | ((uint32_t)s[1] << 8) |
+		    ((uint32_t)s[2] << 16) | ((uint32_t)s[3] << 24);
+		*(volatile uint32_t *)d = v;
+		d += 4; s += 4; n -= 4;
+	}
+	while (n--)
+		*d++ = *s++;
+}
+
+static void
+ud_dma_read(void *dst, const void *src, size_t n)
+{
+	uint8_t *d = dst;
+	const volatile uint8_t *s = src;
+	while (n >= 4 && ((uintptr_t)s & 3) == 0) {
+		uint32_t v = *(const volatile uint32_t *)s;
+		d[0] = (uint8_t)v; d[1] = (uint8_t)(v >> 8);
+		d[2] = (uint8_t)(v >> 16); d[3] = (uint8_t)(v >> 24);
+		d += 4; s += 4; n -= 4;
+	}
+	while (n--)
+		*d++ = *s++;
+}
