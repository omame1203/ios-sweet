+		bool attached = false;
+		if (identity != NULL && identity->init()) {
+			attached = identity->attach(this);
+			if (attached && !identity->start(this)) {
+				identity->detach(this);
+				attached = false;
+			}
+		}
+		if (!attached) {
+			IOLog("SWEET NETID: identity publication failed\n");
+		}
+		OSSafeReleaseNULL(identity);
+	}
