+extern "C" void sweet_usb_copy_mac(uint8_t *address);
+
+/*
+ * The BSD USB Ethernet driver does not use IONetworkingFamily. Publish its
+ * address separately for IOKit identity queries, even while the link is off.
+ * iPadOS 16 MobileGestalt waits for an IONetworkController and searches its
+ * local-mac-address while computing UniqueDeviceID. Without one, lsd's
+ * initial application database seeding and SpringBoard both wait indefinitely.
+ * This is identity metadata only: IOService's default newUserClient rejects
+ * opens, and no Ethernet/Wi-Fi transport is advertised or implemented here.
+ */
+class IONetworkController : public IOService {
+	OSDeclareDefaultStructors(IONetworkController);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+bool
+IONetworkController::start(IOService *provider)
+{
+	uint8_t address[6];
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	sweet_usb_copy_mac(address);
+	setName("ue0");
+	if (!setProperty("local-mac-address", address, sizeof(address)) ||
+	    !setProperty("IOMACAddress", address, sizeof(address)) ||
+	    !setProperty("sweet-identity-only", kOSBooleanTrue)) {
+		return false;
+	}
+	registerService();
+	IOLog("SWEET NETID: published offline USB Ethernet identity\n");
+	return true;
+}
 
