diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -26,22 +26,45 @@
 static vm_offset_t gicr_base;
 static vm_offset_t gicr_size;
 
+/*
+ * On dizi, Android reports a Gunyah hypervisor. A post-indexed MMIO
+ * store to GIC priority registers faulted during dizi bring-up.
+ * C volatile does not constrain the addressing mode selected by the compiler,
+ * so force one fixed-address register access without base writeback.
+ * This remains a compiler barrier, not a hardware memory barrier.
+ */
 static uint32_t
 _gic_read32(vm_offset_t addr)
 {
+#if defined(SWEET)
+	uint32_t value;
+	__asm__ volatile("ldr %w0, [%1]" : "=r" (value) : "r" (addr) : "memory");
+	return value;
+#else
 	return *((volatile uint32_t *) addr);
+#endif
 }
 
 static uint64_t
 _gic_read64(vm_offset_t addr)
 {
+#if defined(SWEET)
+	uint64_t value;
+	__asm__ volatile("ldr %0, [%1]" : "=r" (value) : "r" (addr) : "memory");
+	return value;
+#else
 	return *((volatile uint64_t *) addr);
+#endif
 }
 
 static void
 _gic_write32(vm_offset_t addr, uint32_t value)
 {
+#if defined(SWEET)
+	__asm__ volatile("str %w1, [%0]" : : "r" (addr), "r" (value) : "memory");
+#else
 	*((volatile uint32_t *) addr) = value;
+#endif
 }
 
 #define gicd_read32(offset) (_gic_read32(gicd_base + (offset)))
