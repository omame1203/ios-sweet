diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -635,6 +635,380 @@
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * Dizi Novatek NT36532 over QUPv3 SE9 SPI.
+ * MiCode ruan NT36532 SPI protocol and qcom spi-geni are the source of
+ * the register definitions. No Novatek firmware download or reset is done.
+ * Any unsupported or unsafe inherited GENI mode stops before chip writes.
+ */
+#define DIZI_SPI_PA       0x00a8c000u
+#define DIZI_GCC_PA       0x00120000u
+#define DIZI_GCC_VOTE     0x42008u /* GCC physical 0x162008 */
+#define DIZI_SE_CBCR      0x83a8u  /* GCC physical 0x1283a8 */
+#define DIZI_M_AHB_CBCR   0x8004u
+#define DIZI_S_AHB_CBCR   0x8008u
+#define DIZI_RCG         0x83b0u
+#define DIZI_TLMM_PA      0x0f100000u /* GPIO10 is +0, per-pin stride 0x1000 */
+#define DIZI_TOUCH_MAX    10u
+#define DIZI_TOUCH_REPORT 108u
+#define DIZI_TOUCH_RX     (DIZI_TOUCH_REPORT + 2u) /* command + dummy + payload */
+#define DIZI_NVT_TRIM     0x1fb104u
+#define DIZI_NVT_CASC     0x1fb12cu
+#define DIZI_NVT_EVENT    0x125800u /* NT36532 single and cascade tables agree */
+#define DIZI_SE_ERRORS    (0x0eu | (3u << 24) | (3u << 28))
+#define DIZI_SE_RX_IRQS   ((1u << 26) | (1u << 27))
+#define DIZI_SE_TX_IRQ    (1u << 30)
+#define DIZI_SE_PACK0     0x0007f8feu
+#define DIZI_SE_PACK1     0x000ffefeu
+
+static struct {
+	vm_offset_t se, gcc, tlmm;
+	uint32_t active;
+	int x[DIZI_TOUCH_MAX], y[DIZI_TOUCH_MAX];
+	bool dead;
+} dzt;
+
+static uint32_t
+dz_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v;
+	vm_offset_t addr = base + off;
+	__asm__ volatile("ldr %w0, [%1]" : "=r"(v) : "r"(addr) : "memory");
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+dz_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	vm_offset_t addr = base + off;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	__asm__ volatile("str %w0, [%1]" : : "r"(v), "r"(addr) : "memory");
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+dz_wait_idle(void)
+{
+	for (unsigned n = 0; n < 5000; ++n) {
+		if (!(dz_rd(dzt.se, SE_STATUS) & 0x1001u)) return true;
+		delay(1);
+	}
+	return false;
+}
+
+static void
+dz_release(void)
+{
+	for (unsigned id = 0; id < DIZI_TOUCH_MAX; ++id) {
+		if (dzt.active & (1u << id))
+			sweet_hid_touch(id, 0, dzt.x[id], dzt.y[id]);
+	}
+	dzt.active = 0;
+}
+
+/* MiCode super-resolution frame: header [0], ten records of six bytes,
+ * checksum over packet bytes 1..64, stored at [65]. Invalid data cannot
+ * alter the current HID contact state. Pen reports are deliberately ignored.
+ */
+static bool
+dz_parse(const uint8_t *data, int *x, int *y, uint32_t *mask)
+{
+	unsigned sum = 0;
+	for (unsigned i = 1; i < 65; ++i) sum += data[i];
+	if (((sum + data[65]) & 255u) != 0) return false;
+	bool esd = true, watchdog = true;
+	for (unsigned i = 1; i <= 6; ++i) {
+		esd &= data[i] == 0x77;
+		watchdog &= data[i] == 0xfd || data[i] == 0xfe;
+	}
+	if (esd || watchdog) return false; /* firmware WDT / ESD state */
+	uint32_t bits = 0;
+	for (unsigned i = 0; i < DIZI_TOUCH_MAX; ++i) {
+		const uint8_t *p = &data[1u + 6u * i];
+		unsigned id = p[0] >> 3, state = p[0] & 7u;
+		if (id == 0 || id > DIZI_TOUCH_MAX) continue;
+		if (state != 1u && state != 2u) continue;
+		unsigned px = ((unsigned)p[1] << 8) | p[2];
+		unsigned py = ((unsigned)p[3] << 8) | p[4];
+		if (px >= 16000 || py >= 25600 || (bits & (1u << (id - 1)))) return false;
+		bits |= 1u << (id - 1);
+		x[id - 1] = (int)(px / 10u);
+		y[id - 1] = (int)(py / 10u);
+	}
+	*mask = bits;
+	return true;
+}
+
+static void
+dz_publish(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned i = 0; i < DIZI_TOUCH_MAX; ++i) {
+		uint32_t bit = 1u << i;
+		if (mask & bit) {
+			if (!(dzt.active & bit) || dzt.x[i] != x[i] || dzt.y[i] != y[i])
+				sweet_hid_touch(i, 1, x[i], y[i]);
+			dzt.x[i] = x[i];
+			dzt.y[i] = y[i];
+		} else if (dzt.active & bit) {
+			sweet_hid_touch(i, 0, dzt.x[i], dzt.y[i]);
+		}
+	}
+	dzt.active = mask;
+}
+
+static bool
+dz_clock(void)
+{
+	/* Probe02 checked exactly these three vote bits and observed clocks on.
+	 * We leave this vote held for the lifetime of the touch reader. */
+	const uint32_t mask = (1u << 25) | (3u << 20);
+	dz_wr(dzt.gcc, DIZI_GCC_VOTE, dz_rd(dzt.gcc, DIZI_GCC_VOTE) | mask);
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!((dz_rd(dzt.gcc, DIZI_SE_CBCR) |
+		    dz_rd(dzt.gcc, DIZI_M_AHB_CBCR) |
+		    dz_rd(dzt.gcc, DIZI_S_AHB_CBCR)) & 0x80000000u)) break;
+		delay(1);
+	}
+	if ((dz_rd(dzt.gcc, DIZI_SE_CBCR) | dz_rd(dzt.gcc, DIZI_M_AHB_CBCR) |
+	    dz_rd(dzt.gcc, DIZI_S_AHB_CBCR)) & 0x80000000u) return false;
+	/* RCG from live dizi probe02. Do not reparent clocks or assume that
+	 * 0x00100000 encodes a specific rate. Only accept an already running,
+	 * independently configured root; missing root-clock setup is a blocker. */
+	uint32_t cmd = dz_rd(dzt.gcc, DIZI_RCG);
+	uint32_t cfg = dz_rd(dzt.gcc, DIZI_RCG + 4);
+	printf("DIZI TOUCH: GCC root cmd=%#x cfg=%#x\n", cmd, cfg);
+	if (cmd & 0x80000000u) return false;
+	return true;
+}
+
+static bool
+dz_se_setup(void)
+{
+	uint32_t fw = dz_rd(dzt.se, SE_FW);
+	uint32_t tx = dz_rd(dzt.se, SE_HW_TX), rx = dz_rd(dzt.se, SE_HW_RX);
+	uint32_t fifo = dz_rd(dzt.se, 0x64);
+	printf("DIZI TOUCH: SE9 fw=%#x tx=%#x rx=%#x fifo-disable=%#x dma=%#x\n",
+	    fw, tx, rx, fifo, dz_rd(dzt.se, SE_DMA));
+	if (((fw >> 8) & 255u) != 1u || (fifo & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 4u || ((rx >> 16) & 0x3fu) < 4u ||
+	    !dz_wait_idle() || (dz_rd(dzt.se, SE_TX_COUNT) & 0xfffffff) ||
+	    (dz_rd(dzt.se, SE_RX_COUNT) & 0x1ffffff)) {
+		printf("DIZI TOUCH: unsupported firmware/FIFO or busy; need GPI DMA integration\n");
+		return false;
+	}
+	/* 19.2 MHz XO / 2 is 9.6 MHz only when the source and RCG
+	 * divider are configured by a known clock owner. Until then skip. */
+	if ((dz_rd(dzt.gcc, DIZI_RCG + 4) & 0x371fu) != 1u) {
+		printf("DIZI TOUCH: root clock not verified XO / 1\n");
+		return false;
+	}
+	dz_wr(dzt.se, 0xe18, 0);
+	dz_wr(dzt.se, 0xe1c, 0);
+	dz_wr(dzt.se, 0x644, 0);
+	dz_wr(dzt.se, SE_IRQ_CLR, 0xffffffffu);
+	dz_wr(dzt.se, 0x648, 0xffffffffu);
+	dz_wr(dzt.se, SE_DMA, 0);
+	dz_wr(dzt.se, SE_CLK_SEL, 0);
+	dz_wr(dzt.se, SE_MCLK, (2u << 4) | 1u);
+	dz_wr(dzt.se, 0x224, 0);
+	dz_wr(dzt.se, 0x230, 0);
+	dz_wr(dzt.se, 0x22c, 0);
+	dz_wr(dzt.se, 0x24c, 0);
+	dz_wr(dzt.se, 0x250, 0); /* hardware CS0 */
+	dz_wr(dzt.se, 0x268, 4); /* word length 8 - minimum 4 */
+	dz_wr(dzt.se, 0x25c, dz_rd(dzt.se, 0x25c) & ~2u);
+	dz_wr(dzt.se, 0x254, 0);
+	dz_wr(dzt.se, 0x260, DIZI_SE_PACK0);
+	dz_wr(dzt.se, 0x264, DIZI_SE_PACK1);
+	dz_wr(dzt.se, 0x284, DIZI_SE_PACK0);
+	dz_wr(dzt.se, 0x288, DIZI_SE_PACK1);
+	dz_wr(dzt.se, SE_TX_WM, 0);
+	dz_wr(dzt.se, 0x810, 0);
+	dz_wr(dzt.se, 0x814, ((rx >> 16) & 0x3fu) - 2u);
+	dz_wr(dzt.se, SE_IRQ_EN, SE_DONE | DIZI_SE_ERRORS | DIZI_SE_TX_IRQ | DIZI_SE_RX_IRQS);
+	return (dz_rd(dzt.se, SE_DMA) & 1u) == 0 &&
+	    dz_rd(dzt.se, 0x260) == DIZI_SE_PACK0;
+}
+
+/* A bounded FIFO full-duplex SPI command. Hardware handles CS0 with a
+ * separate assert/deassert instruction; never attempt GPI ring programming. */
+static bool
+dz_command(unsigned opcode, unsigned param)
+{
+	if (!dz_wait_idle()) return false;
+	dz_wr(dzt.se, SE_IRQ_CLR, 0xffffffffu);
+	dz_wr(dzt.se, SE_CMD, (opcode << 27) | param);
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = dz_rd(dzt.se, SE_IRQ);
+		if (irq & DIZI_SE_ERRORS) break;
+		if (irq & SE_DONE) {
+			dz_wr(dzt.se, SE_IRQ_CLR, irq);
+			return dz_wait_idle();
+		}
+		delay(1);
+	}
+	dzt.dead = true; /* Never start another command after ambiguous completion. */
+	printf("DIZI TOUCH: SPI command timeout/error irq=%#x\n", dz_rd(dzt.se, SE_IRQ));
+	return false;
+}
+
+static bool
+dz_exchange(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	if (n == 0 || n > DIZI_TOUCH_RX || dzt.dead || !dz_wait_idle()) return false;
+	if (!dz_command(8, 0)) return false; /* CS assert */
+	bool ok = false;
+	unsigned sent = 0, got = 0;
+	dz_wr(dzt.se, SE_IRQ_CLR, 0xffffffffu);
+	dz_wr(dzt.se, SE_TX_WM, 1);
+	dz_wr(dzt.se, SE_TX_LEN, n);
+	dz_wr(dzt.se, SE_RX_LEN, n);
+	dz_wr(dzt.se, SE_CMD, (7u << 27) | 4u); /* TX_RX, fragment CS */
+	for (unsigned tick = 0; tick < 50000; ++tick) {
+		uint32_t irq = dz_rd(dzt.se, SE_IRQ);
+		if (irq & DIZI_SE_ERRORS) break;
+		if ((irq & DIZI_SE_TX_IRQ) && sent < n) {
+			unsigned depth = (dz_rd(dzt.se, SE_HW_TX) >> 16) & 0x3fu;
+			unsigned used = dz_rd(dzt.se, SE_TX_COUNT) & 0x0fffffffu;
+			if (used > depth) break;
+			unsigned space = depth - used;
+			for (; space && sent < n; --space) {
+				uint32_t word = 0;
+				for (unsigned b = 0; b < 4 && sent < n; ++b)
+					word |= (uint32_t)tx[sent++] << (8u * b);
+				dz_wr(dzt.se, SE_TX, word);
+			}
+			if (sent == n) dz_wr(dzt.se, SE_TX_WM, 0);
+		}
+		unsigned count = dz_rd(dzt.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > (n - got + 3u) / 4u || count > 64u) break;
+		while (count--) {
+			uint32_t word = dz_rd(dzt.se, SE_RX);
+			for (unsigned b = 0; b < 4 && got < n; ++b)
+				rx[got++] = (uint8_t)(word >> (8u * b));
+		}
+		if (irq & SE_DONE) {
+			ok = sent == n && got == n && !(dz_rd(dzt.se, SE_IRQ) & DIZI_SE_ERRORS);
+			dz_wr(dzt.se, SE_IRQ_CLR, irq);
+			break;
+		}
+		dz_wr(dzt.se, SE_IRQ_CLR, irq & (DIZI_SE_RX_IRQS | DIZI_SE_TX_IRQ));
+		delay(1);
+	}
+	dz_wr(dzt.se, SE_TX_WM, 0);
+	if (!ok) {
+		dzt.dead = true;
+		printf("DIZI TOUCH: SPI transfer failed, stopping\n");
+		return false;
+	}
+	return dz_command(9, 0); /* CS deassert */
+}
+
+static bool
+dz_nvt_write(const uint8_t *data, unsigned n)
+{
+	uint8_t tx[DIZI_TOUCH_RX] = {0}, rx[DIZI_TOUCH_RX] = {0};
+	if (n > DIZI_TOUCH_RX || n == 0) return false;
+	memcpy(tx, data, n);
+	tx[0] |= 0x80u;
+	return dz_exchange(tx, rx, n);
+}
+
+static bool
+dz_nvt_read(unsigned offset, uint8_t *out, unsigned n)
+{
+	uint8_t tx[DIZI_TOUCH_RX] = {0}, rx[DIZI_TOUCH_RX] = {0};
+	if (n + 2u > DIZI_TOUCH_RX || offset > 0x7fu) return false;
+	tx[0] = (uint8_t)offset;
+	if (!dz_exchange(tx, rx, n + 2u)) return false;
+	memcpy(out, rx + 2, n); /* MiCode explicitly discards rx[0..1] */
+	return true;
+}
+
+static bool
+dz_nvt_page(uint32_t addr)
+{
+	uint8_t cmd[3] = {0xffu, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7)};
+	return dz_nvt_write(cmd, sizeof(cmd));
+}
+
+static bool
+dz_nvt_reg(uint32_t addr, uint8_t *out, unsigned n)
+{
+	return dz_nvt_page(addr) && dz_nvt_read(addr & 0x7fu, out, n);
+}
+
+static void
+dz_touch_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	unsigned delay_s = 45;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	if (delay_s > 120u) delay_s = 120u;
+	printf("DIZI TOUCH: starting after %u seconds\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	dzt.gcc = ml_io_map(DIZI_GCC_PA, 0x50000);
+	dzt.tlmm = ml_io_map(DIZI_TLMM_PA, 0x2d000);
+	if (!dzt.gcc || !dzt.tlmm) goto out;
+	/* All four SPI lines must already have the same pinctrl mux1 as the FDT.
+	 * GPIO13 is currently a GPIO output in probe02 and is not changed. */
+	for (unsigned n = 0; n < 4; ++n) {
+		uint32_t cfg = dz_rd(dzt.tlmm, 0x1000u * n);
+		if (((cfg >> 2) & 0xfu) != 1u) {
+			printf("DIZI TOUCH: GPIO%u mux=%#x; CS0/pinmux not ready\n", 10u + n, cfg);
+			goto out;
+		}
+	}
+	if (!dz_clock()) {
+		printf("DIZI TOUCH: SE9 root clock unavailable\n");
+		goto out;
+	}
+	dzt.se = ml_io_map(DIZI_SPI_PA, 0x4000);
+	if (!dzt.se || !dz_se_setup()) goto out;
+	uint8_t trim[6], casc, reset, fwinfo[2];
+	if (!dz_nvt_reg(DIZI_NVT_TRIM, trim, 6) ||
+	    trim[3] != 0x32 || trim[4] != 0x65 || trim[5] != 0x03 ||
+	    !dz_nvt_reg(DIZI_NVT_CASC, &casc, 1)) {
+		printf("DIZI TOUCH: NT36532 identity missing\n");
+		goto out;
+	}
+	printf("DIZI TOUCH: NT36532 identity OK, cascade=%u\n", !(casc & 1u));
+	if (!dz_nvt_reg(DIZI_NVT_EVENT + 0x60, &reset, 1) ||
+	    !dz_nvt_reg(DIZI_NVT_EVENT + 0x78, fwinfo, 2) ||
+	    reset < 0xa0 || reset > 0xaf || ((fwinfo[0] + fwinfo[1]) & 255u) != 255u) {
+		printf("DIZI TOUCH: SRAM firmware handshake unavailable, no touch events\n");
+		goto out;
+	}
+	/* Leave the event buffer page selected for firmware touch report reads. */
+	if (!dz_nvt_page(DIZI_NVT_EVENT)) goto out;
+	printf("DIZI TOUCH: verified firmware %#x, polling IRQ54\n", fwinfo[0]);
+	unsigned errors = 0;
+	for (;;) {
+		/* GPIO54 input is active-low; periodic sampling recovers missed edges. */
+		if (dzt.active || !(dz_rd(dzt.tlmm, 44u * 0x1000u + 4u) & 1u)) {
+			uint8_t pkt[DIZI_TOUCH_REPORT] = {0};
+			int x[DIZI_TOUCH_MAX] = {0}, y[DIZI_TOUCH_MAX] = {0};
+			uint32_t mask = 0;
+			if (dz_nvt_read(0, pkt, sizeof(pkt)) && dz_parse(pkt, x, y, &mask)) {
+				dz_publish(mask, x, y);
+				errors = 0;
+			} else if (++errors >= 10) {
+				dz_release();
+				if (dzt.dead) break;
+				errors = 0;
+			}
+		}
+		touch_wait(10);
+	}
+	out:
+	dz_release();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
