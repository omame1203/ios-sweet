+/* Dizi's inherited device reports sense 02/04/02 on all enabled LUs.
+ * Linux ufshcd_set_dev_pwr_mode uses SSU on the UFS device WLUN (0xd0),
+ * with ACTIVE=1 in the power-condition field. No user blocks are written. */
+static int
+ufs_activate_device(void)
+{
+	static const uint8_t active[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	uint8_t lun = su.lun;
+	su.lun = 0xd0;
+	int error = ufs_scsi_retry(active, sizeof(active), 0, false);
+	su.lun = lun;
+	printf("SWEET UFS: dizi device ACTIVE %s (%d)\n", error ? "failed" : "ready", error);
+	return error;
+}
