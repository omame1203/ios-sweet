+/* REQUEST SENSE fills the bounce buffer; never use it for a write retry. */
+static int
+ufs_request_sense(void)
+{
+	static const uint8_t cdb[6] = { 0x03, 0, 0, 0, 252, 0 };
+	int error = ufs_scsi(cdb, sizeof(cdb), 252, false);
+	if (!error) {
+		const uint8_t *s = (const uint8_t *)(su.dma + DMA_BOUNCE);
+		printf("SWEET UFS: sense 0x%02x/0x%02x/0x%02x key %u\n",
+		    s[0], s[12], s[13], s[2] & 0xf);
+	}
+	return error;
+}
+
+static int
+ufs_scsi_retry(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	int error = 0;
+	for (int i = 0; i < 5; i++) {
+		error = ufs_scsi(cdb, cdb_len, len, write);
+		if (error != EAGAIN) {
+			return error;
+		}
+		if (len && write) {
+			return error;
+		}
+		(void)ufs_request_sense();
+		delay(10);
+	}
+	return error;
+}
